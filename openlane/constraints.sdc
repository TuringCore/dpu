# generated by the standalone sky130 DPU scaffold

# Clock definition
create_clock [get_ports {clk}] -name clk -period 10

# Conservative timing budget for the first signoff-quality pass
set_input_delay 1.0 -clock clk [all_inputs]
set_output_delay 1.0 -clock clk [all_outputs]

# Keep the design simple and predictable while the physical flow is being tuned
set_max_transition 1.5 [current_design]
set_max_fanout 10 [current_design]

# If you later add a real padframe, update these constraints to reflect the
# pad-to-core boundary rather than the raw core ports.
